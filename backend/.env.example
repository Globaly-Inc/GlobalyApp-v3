# Database
DB_USERNAME=master_user
DB_PASSWORD=password
DB_NAME=globalyapp
DB_HOST=localhost
DB_PORT=5432

# Auth
JWT_SECRET=your-secret-key
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=30
SESSION_EXPIRY_DAYS=30

# Server
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001

# Queue (LavinMQ / RabbitMQ)
LAVINMQ_URL=amqp://guest:guest@localhost:5672

# Mail (SMTP — Mailtrap for dev, any SMTP for prod)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password


# GCP Storage
GCS_BUCKET_NAME=your-bucket
GCS_PROJECT_ID=your-project-id
GCS_KEY_FILE=path/to/service-account.json
GCS_SIGNED_URL_EXPIRY=3600
GCS_MAX_FILE_SIZE_MB=10

# AgentCIS (agent-CRM platform — search/import/bulk-crawl institutions into extraction)
# Optional: unset means search/import/bulk-crawl all no-op gracefully (empty results,
# queued jobs marked failed) instead of erroring. See admin/data/agentcis-import.
# AGENTCIS_BASE_URL=https://api.superadmin.agentcis.com/partner-product-database
# AGENTCIS_API_KEY=your-agentcis-key

# Cache (Dragonfly / Redis)
DRAGONFLY_HOST=dragonfly
DRAGONFLY_PORT=6379

# Maps (Places Autocomplete + Details for address lookup)
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Billing
# CHARGEBEE_SITE=your-site
# CHARGEBEE_API_KEY=your-key


# Higgsfield text-to-image API key for AI blog cover generation. Unset = blogs
# generate without covers (the job notes the missing cover, never fails on it).
# HIGGSFIELD_API_KEY=your-higgsfield-api-key

# Google Search Console integration for the SEO/AEO dashboard. Path to a service
# account JSON key (the account must be added as a user on the GSC property) and
# the verified property, e.g. sc-domain:globalyhub.com. Unset = the SEO page
# shows setup instructions instead of data; nothing crashes.
# GSC_KEY_FILE=./gsc-service-account.json
# GSC_SITE_URL=sc-domain:globalyhub.com
AGENTCIS_BASE_URL=https://domain-name.com/partner-product-database


# AI / LLM
########################
GEMINI_API_KEY=your-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

FIRECRAWL_API_KEY=your-key
CRAWL4AI_BASE_URL=firecrawler.globalyapp.internal

SCRAPLING_BASE_URL=http://scrapling-mcp:8000
SCRAPLING_API_KEY=apikey
