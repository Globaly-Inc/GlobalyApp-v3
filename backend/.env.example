# Database
DB_USERNAME=master_user
DB_PASSWORD=password
DB_NAME=globalyapp
DB_HOST=localhost
DB_PORT=5432

# Auth
JWT_SECRET=your-secret-key
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=30
SESSION_EXPIRY_DAYS=30

# Server
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001

# Queue (LavinMQ / RabbitMQ)
LAVINMQ_URL=amqp://guest:guest@localhost:5672

# Mail (SMTP — Mailtrap for dev, any SMTP for prod)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password

# AI / LLM
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.5-flash
# Must match the vector(3072) columns on extraction_memory and ai_knowledge_*.
# text-embedding-004 returns 768 dims and embed() rejects it at runtime.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Scrapers
FIRECRAWL_API_KEY=your-firecrawl-key
# CRAWL4AI_BASE_URL=https://your-crawl4ai.railway.app
# CRAWL4AI_API_KEY=your-crawl4ai-key

# GCP Storage
GCS_BUCKET_NAME=your-bucket
GCS_PROJECT_ID=your-project-id
GCS_KEY_FILE=path/to/service-account.json
GCS_SIGNED_URL_EXPIRY=3600
GCS_MAX_FILE_SIZE_MB=10

# Cache (Dragonfly / Redis)
DRAGONFLY_URL=redis://localhost:6379

# Maps (Places Autocomplete + Details for address lookup)
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Billing
# CHARGEBEE_SITE=your-site
# CHARGEBEE_API_KEY=your-key

# FX rates cache (exchangerate-api.com — the provider V1 and V2 both use).
# Unset: the cache can be read but never refilled. /api/v3/fx-rates then serves a
# stale snapshot in preference to failing, and 503s only when nothing is cached.
FX_API_KEY=

# Cross-app GlobalyAI feed (§3.4). Two secrets on purpose — pulling the catalogue and
# pushing into extraction staging are different privileges. Unset: both surfaces 503.
GLOBALY_AI_SYNC_SECRET=
WEBHOOK_INGEST_SECRET=
