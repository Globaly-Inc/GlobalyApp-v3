# Database
DB_USERNAME=master_user
DB_PASSWORD=password
DB_NAME=globalyapp
DB_HOST=localhost
DB_PORT=5432

# Auth
JWT_SECRET=your-secret-key
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Server
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001

# Queue (LavinMQ / RabbitMQ)
LAVINMQ_HOST=localhost
LAVINMQ_PORT=5672
LAVINMQ_USERNAME=guest
LAVINMQ_PASSWORD=guest

# Mail (Mailtrap for dev, any SMTP for prod)
SMTP_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password

# Third-party (optional)
DRAGONFLY_HOST=localhost
DRAGONFLY_PORT=6379
CHARGEBEE_SITE=your-site
CHARGEBEE_API_KEY=xxxxx

# Vault
VAULT_KEK=your-encryption-key
