# Database
DB_USERNAME=master_user
DB_PASSWORD=password
DB_NAME=globalyapp
DB_HOST=localhost
DB_PORT=5432

# Auth
JWT_SECRET=your-secret-key
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=30
SESSION_EXPIRY_DAYS=30

# Server
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001

# Queue (LavinMQ / RabbitMQ)
LAVINMQ_URL=amqp://guest:guest@localhost:5672

# Mail (SMTP — Mailtrap for dev, any SMTP for prod)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password

# AI / LLM
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Scrapers
FIRECRAWL_API_KEY=your-firecrawl-key
# CRAWL4AI_BASE_URL=https://your-crawl4ai.railway.app
# CRAWL4AI_API_KEY=your-crawl4ai-key

# GCP Storage
# Storage. Leave GCS_BUCKET_NAME empty to use the local filesystem driver — uploads then write to
# LOCAL_STORAGE_DIR and are served back via signed /api/v3/files/local URLs, so image and video upload work
# with no bucket. API_PUBLIC_URL is the origin the BROWSER uses to reach this API (media URLs must be
# absolute); defaults to http://localhost:$PORT.
LOCAL_STORAGE_DIR=.uploads
API_PUBLIC_URL=http://localhost:3000
GCS_BUCKET_NAME=your-bucket
GCS_PROJECT_ID=your-project-id
GCS_KEY_FILE=path/to/service-account.json
GCS_SIGNED_URL_EXPIRY=3600
GCS_MAX_FILE_SIZE_MB=10

# Cache (Dragonfly / Redis)
DRAGONFLY_URL=redis://localhost:6379

# Billing
# CHARGEBEE_SITE=your-site
# CHARGEBEE_API_KEY=your-key

