{
  "name": "globalyhub-backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "build": "tsc",
    "migrate:globalyapp": "node --import tsx node_modules/.bin/knex migrate:latest --knexfile knexfile.ts --env globalyapp",
    "migrate:superadmin": "node --import tsx node_modules/.bin/knex migrate:latest --knexfile knexfile.ts --env superadmin",
    "migrate:tenants": "node --import tsx src/workers/migration-runner.ts",
    "import:v2": "node --import tsx scripts/import-v2.ts",
    "seed:globalyapp": "node --import tsx node_modules/.bin/knex seed:run --knexfile knexfile.ts --env globalyapp",
    "seed:superadmin": "node --import tsx node_modules/.bin/knex seed:run --knexfile knexfile.ts --env superadmin",
    "job:auth": "node --import tsx src/modules/auth/jobs/email.worker.ts",
    "job:extraction": "node --import tsx src/modules/superadmin/data-extraction/workers/extraction-job.worker.ts",
    "job:extraction-pages": "node --import tsx src/modules/superadmin/data-extraction/workers/extraction-page.worker.ts",
    "job:extraction-verify": "node --import tsx src/modules/superadmin/data-extraction/workers/extraction-verify.worker.ts",
    "job:extraction-step": "node --import tsx src/modules/superadmin/data-extraction/workers/extraction-step.worker.ts",
    "job:extraction-schedule": "node --import tsx src/modules/superadmin/data-extraction/workers/extraction-schedule.worker.ts",
    "job:extraction-agentcis": "node --import tsx src/modules/superadmin/data-extraction/workers/extraction-agentcis.worker.ts",
    "job:ai-knowledge-crawl": "node --import tsx src/modules/superadmin/ai-knowledge/workers/knowledge-crawl.worker.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "migrate:v1-geo": "node database/scripts/import-v1-geo.mjs",
    "migrate:v1-country-fks": "node database/scripts/backfill-country-fks.mjs",
    "migrate:v1-reference": "node database/scripts/import-v1-reference.mjs",
    "migrate:v1-student-subprofiles": "node database/scripts/import-v1-student-subprofiles.mjs",
    "import:v1-extraction": "node database/scripts/import-v1-extraction.mjs",
    "verify:migration": "node database/scripts/verify-migration.mjs",
    "test:migration": "vitest run --project integration tests/integration/verify-migration.test.ts",
    "migrate:v1-extraction-refs": "node database/scripts/backfill-extraction-reference-ids.mjs",
    "migrate:v1-billing": "node --import tsx database/scripts/import-v1-billing.ts",
    "migrate:v1-extract": "node scripts/migration/extract.mjs",
    "migrate:v1-extract-ddl": "node scripts/migration/extract.mjs --emit-ddl",
    "verify:staging": "node scripts/migration/verify-staging.mjs",
    "migrate:ensure-mig": "node --import tsx scripts/migration/lib.ts --ensure-mig",
    "check:migration": "node scripts/migration/extract.mjs --self-check && node scripts/migration/verify-staging.mjs --self-check && node --import tsx scripts/migration/lib.ts --self-check && node database/scripts/verify-migration.mjs --self-check",
    "job:enquiry-digest": "node --import tsx src/workers/enquiry-digest.worker.ts",
    "migrate:w1-geo": "node --import tsx scripts/migration/w1-geo.ts",
    "migrate:w1-identity": "node --import tsx scripts/migration/w1-identity.ts",
    "migrate:w1-businesses": "node --import tsx scripts/migration/w1-businesses.ts",
    "migrate:w1-tenants": "node --import tsx scripts/migration/w1-tenants.ts",
    "migrate:w2-reference": "node --import tsx scripts/migration/w2-reference.ts",
    "migrate:w3-subprofiles": "node --import tsx scripts/migration/w3-subprofiles.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@google-cloud/storage": "^7.21.0",
    "@google/generative-ai": "^0.24.1",
    "@opentelemetry/api": "^1.9.1",
    "amqplib": "^2.0.1",
    "dotenv": "^16.4.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "jsonwebtoken": "^9.0.0",
    "knex": "^3.1.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.13.0",
    "winston": "^3.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
