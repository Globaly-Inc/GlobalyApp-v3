    "test:counsellor-briefing": "node --import tsx tests/counsellor-briefing.ts",
    "diagnose:promote": "node --import tsx scripts/diagnose-promote.ts",
    "job:ai-knowledge-crawl": "node --import tsx src/modules/superadmin/ai-knowledge/workers/knowledge-crawl.worker.ts",
    "job:ai-knowledge-recrawl": "node --import tsx src/modules/superadmin/ai-knowledge/workers/knowledge-recrawl-dispatch.worker.ts",
    "job:business-claim-requests": "node --import tsx src/modules/superadmin/platform/businesses/workers/claim-requests-bulk.worker.ts",
    "job:enquiry-match": "node --import tsx src/modules/enquiries/workers/enquiry-match.worker.ts",
    "job:enquiry-email": "node --import tsx src/modules/enquiries/workers/enquiry-email.worker.ts",
    "job:scholarship-import": "node --import tsx src/modules/superadmin/monitoring/scholarships/workers/scholarship-import.worker.ts",
    "job:scholarship-bulk-delete": "node --import tsx src/modules/superadmin/monitoring/scholarships/workers/scholarship-bulk-delete.worker.ts",
    "lint": "eslint src/",
    "job:blog-generate": "node --import tsx src/modules/superadmin/marketing/blog/workers/blog-generate.worker.ts",
    "job:guide-email": "node --import tsx src/modules/superadmin/marketing/guides/workers/guide-email.worker.ts",
    "job:seo-snapshot": "node --import tsx src/modules/superadmin/marketing/seo/workers/seo-snapshot.worker.ts",
    "test:seo-aeo": "node --import tsx tests/seo-aeo.ts",
    "test:guides": "node --import tsx tests/guides.ts",
    "test:integration-settings": "node --import tsx tests/integration-settings.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@google-cloud/storage": "^7.21.0",
    "@google/generative-ai": "^0.24.1",
    "@googleapis/searchconsole": "^7.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "amqplib": "^2.0.1",
    "dotenv": "^16.4.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "google-auth-library": "^10.5.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.0",
    "knex": "^3.1.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.13.0",
    "tsx": "^4.19.0",
    "winston": "^3.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "typescript": "^5.7.0"
  }
}
