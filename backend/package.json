{
  "name": "globalyhub-backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "build": "tsc",
    "migrate:globalyapp": "node --import tsx node_modules/.bin/knex migrate:latest --knexfile knexfile.ts --env globalyapp",
    "migrate:superadmin": "node --import tsx node_modules/.bin/knex migrate:latest --knexfile knexfile.ts --env superadmin",
    "migrate:tenants": "node --import tsx src/workers/migration-runner.ts",
    "seed:tenants": "node --import tsx src/workers/seed-runner.ts",
    "import:v2": "node --import tsx scripts/import-v2.ts",
    "embed:backfill": "node --import tsx scripts/embed-backfill.ts",
    "chunk:backfill": "node --import tsx scripts/chunk-backfill.ts",
    "ai:evals": "node --import tsx scripts/ai-evals/run-evals.ts",
    "gcs:cors": "node --import tsx scripts/set-gcs-cors.ts",
    "seed:globalyapp": "node --import tsx node_modules/.bin/knex seed:run --knexfile knexfile.ts --env globalyapp",
    "seed:v2-businesses": "node --import tsx node_modules/.bin/knex seed:run --knexfile knexfile.ts --env globalyapp --specific v2_businesses_import_seeder.ts",
    "seed:superadmin": "node --import tsx node_modules/.bin/knex seed:run --knexfile knexfile.ts --env superadmin",
    "job:auth": "node --import tsx src/modules/auth/jobs/email.worker.ts",
    "job:referral-codes": "node --import tsx src/modules/referrals/workers/backfill-referral-codes.worker.ts",
    "test:referrals": "node --import tsx tests/referrals.ts",
    "test:saved-items": "node --import tsx tests/saved-items.ts",
    "test:page-views": "node --import tsx tests/page-views.ts",
    "test:enquiry-messages": "node --import tsx tests/enquiries/messages.ts",
    "test:scraper-cascade": "node --import tsx tests/scraper-cascade.ts",
    "test:chunker": "node --import tsx tests/chunker.ts",
    "test:rack-chunk-budget": "node --import tsx tests/rack-chunk-budget.ts",
    "test:ai-tool-loop": "node --import tsx tests/ai-tool-loop.ts",
    "test:counselling-context": "node --import tsx tests/counselling-context.ts",
    "test:ai-counsellor-flow": "node --import tsx tests/ai-counsellor-flow.ts",
    "test:ai-evals-checks": "node --import tsx tests/ai-evals-checks.ts",
    "test:subscribers": "node --import tsx tests/subscribers.ts",
    "test:blog-generation": "node --import tsx tests/blog-generation.ts",
    "job:extraction": "node --import tsx src/modules/superadmin/data-extraction/workers/extraction-job.worker.ts",
    "job:extraction-pages": "node --import tsx src/modules/superadmin/data-extraction/workers/extraction-page.worker.ts",
    "job:extraction-verify": "node --import tsx src/modules/superadmin/data-extraction/workers/extraction-verify.worker.ts",
    "job:extraction-step": "node --import tsx src/modules/superadmin/data-extraction/workers/extraction-step.worker.ts",
    "job:extraction-schedule": "node --import tsx src/modules/superadmin/data-extraction/workers/extraction-schedule.worker.ts",
    "job:extraction-agentcis": "node --import tsx src/modules/superadmin/data-extraction/workers/extraction-agentcis.worker.ts",
    "job:extraction-course-bulk-delete": "node --import tsx src/modules/superadmin/data-extraction/workers/extraction-course-bulk-delete.worker.ts",
    "job:import-v2": "node --import tsx src/modules/superadmin/data-extraction/workers/import-v2.worker.ts",
    "job:backfill-promote": "node --import tsx src/modules/superadmin/data-extraction/workers/backfill-promote.worker.ts",
