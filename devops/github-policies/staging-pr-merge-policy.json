{
  "id": 18223219,
  "name": "staging-pr-merge-policy",
  "target": "branch",
  "source_type": "Repository",
  "source": "Globaly-Inc/GlobalyOS-v3",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/heads/staging",
        "refs/heads/develop"
      ]
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": false,
        "required_reviewers": [],
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": [
          "merge",
          "squash",
          "rebase"
        ]
      }
    }
  ],
  "bypass_actors": [
    {
      "actor_id": 16881134,
      "actor_type": "Team",
      "bypass_mode": "always"
    }
  ]
}