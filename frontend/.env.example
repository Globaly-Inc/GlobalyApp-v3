
NEXT_PUBLIC_MOCK_DATA=true

NEXT_PUBLIC_API_URL=http://localhost:3000/

# Where the browser reaches this app (used to build referral links). Set per environment.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Maps JavaScript API key for the business/personal profile location map (marker + geocoding).
# Distinct from the backend's GOOGLE_MAPS_API_KEY, which only ever proxies Places autocomplete/
# details server-side and is never exposed to the browser. This one is meant to be client-side —
# restrict it in the Google Cloud Console to this app's domain(s). Unset means the map is skipped
# gracefully (a plain address list still renders) instead of erroring.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-js-key
