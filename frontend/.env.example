
NEXT_PUBLIC_MOCK_DATA=true

NEXT_PUBLIC_API_URL=http://localhost:3000/

# for referral
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Maps JavaScript API key for the business/personal profile location map (marker + geocoding).
# Distinct from the backend's GOOGLE_MAPS_API_KEY, which only ever proxies Places autocomplete/
# details server-side and is never exposed to the browser. This one is meant to be client-side —
# restrict it in the Google Cloud Console to this app's domain(s). Unset means the map is skipped
# gracefully (a plain address list still renders) instead of erroring.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-js-key

# Workspace token for the GlobalyOS support widget (https://globalyos.com/sdk-v1.js), loaded in the
# root layout. Client-side by design — it ships to every visitor in the HTML, so it identifies a
# workspace rather than authenticating one. Use the token for the matching GlobalyOS environment;
# a staging token on production routes real tickets into the wrong workspace. Unset means the
# widget is skipped entirely instead of loading with an empty token.
# NEXT_PUBLIC_GLOBALYOS_SUPPORT_TOKEN=your-globalyos-workspace-token
