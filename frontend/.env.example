# Mocks are opt-in. ONLY the literal string "true" turns them on — unset, empty, or
# anything else serves the real API. Never set this to "true" outside local UI work:
# with mocks on, every screen renders fixtures and a red "MOCK DATA" badge is shown.
NEXT_PUBLIC_MOCK_DATA=false

NEXT_PUBLIC_API_URL=http://localhost:3000/
