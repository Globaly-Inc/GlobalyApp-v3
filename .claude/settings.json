      "Bash(less *.claude/settings.json)",
      "Bash(more .claude/settings.json)",
      "Bash(more *.claude/settings.json)",
      "Bash(head .claude/settings.json)",
      "Bash(head *.claude/settings.json)",
      "Bash(tail .claude/settings.json)",
      "Bash(tail *.claude/settings.json)",
      "Bash(bat .claude/settings.json)",
      "Bash(bat *.claude/settings.json)",
      "Bash(zsh -c *.claude/settings.json*)",
