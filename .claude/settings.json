      "PowerShell(type .claude/settings.json)",
      "PowerShell(type *.claude/settings.json)",
      "Bash(gh *)",
      "WebFetch(domain:api.github.com)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "./devops/github-policies",
        "./devops/github-policies/**",
        "./.claude/settings.json",
        "**/GlobalyApp-v3/devops/github-policies",
        "**/GlobalyApp-v3/devops/github-policies/**",
        "**/GlobalyApp-v3/.claude/settings.json"
      ]
    },
    "network": {
      "deniedDomains": [
        "api.github.com"
      ]
    }
  }
